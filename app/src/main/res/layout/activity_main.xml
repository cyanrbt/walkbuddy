<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/home_scroll"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"
    android:background="@color/paper" android:clipToPadding="false" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp" android:paddingBottom="32dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hero_title"
            android:textSize="28sp" android:textColor="@color/ink_text" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.03"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="@string/brand_caption" style="@style/Buddy.Body"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="24dp" android:background="@drawable/bg_hero" android:padding="22dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/hero_kicker"
                        android:textColor="@color/mint_bright" android:textSize="12sp" android:letterSpacing="0.10"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                        android:text="@string/hero_message" android:textColor="@color/on_ink" android:textSize="26sp" android:fontFamily="sans-serif-medium" android:lineSpacingExtra="4dp"/>
                </LinearLayout>
                <ImageView android:layout_width="112dp" android:layout_height="128dp" android:layout_marginStart="4dp"
                    android:src="@drawable/walkbuddy_mascot" android:scaleType="fitCenter" android:importantForAccessibility="no" android:contentDescription="@null"/>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="@string/hero_lead" android:textColor="@color/on_ink_dim" android:textSize="14sp" android:lineSpacingExtra="5dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_label"
                android:textColor="@color/mint" android:textSize="12sp" android:fontFamily="sans-serif-medium"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:layout_marginEnd="8dp" android:text="@string/status_initial"
                    android:textColor="@color/ink_text" android:textSize="15sp" android:lineSpacingExtra="4dp"/>
                <Button android:id="@+id/stop" android:layout_width="72dp" android:layout_height="wrap_content" style="@style/Buddy.Button"
                    android:background="@drawable/bg_stop" android:text="@string/preview_stop" android:textColor="@color/stop_text"/>
            </LinearLayout>
            <Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Buddy.Button"
                android:background="@drawable/bg_primary" android:text="@string/start" android:textColor="@color/on_ink"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="@string/caution" style="@style/Buddy.Body" android:textSize="12sp"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="12dp"
            android:text="@string/prepare" style="@style/Buddy.Section"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card">
        <LinearLayout
            android:id="@+id/row_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">
            <TextView
                android:id="@+id/badge_camera"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_badge"
                android:text="1"
                android:textColor="@color/on_ink"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_camera"
                    android:textColor="@color/ink_text"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_camera_hint"
                    android:textColor="@color/muted"
                    android:textSize="12sp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/state_camera"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/access_needed"
                android:textColor="@color/mint"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="62dp"
            android:background="@color/line"/>
        <LinearLayout
            android:id="@+id/row_pip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">
            <TextView
                android:id="@+id/badge_pip"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_badge"
                android:text="2"
                android:textColor="@color/on_ink"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_pip"
                    android:textColor="@color/ink_text"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_pip_hint"
                    android:textColor="@color/muted"
                    android:textSize="12sp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/state_pip"
                android:layout_width="72dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/access_needed"
                android:textColor="@color/mint"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        </LinearLayout>


        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:layout_marginBottom="12dp"
            android:text="@string/guide_title" style="@style/Buddy.Section"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/section_use" style="@style/Buddy.Section" android:textSize="14sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/use_body" style="@style/Buddy.Body"/>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="18dp" android:layout_marginBottom="18dp" android:background="@color/line"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/section_see" style="@style/Buddy.Section" android:textSize="14sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/see_body" style="@style/Buddy.Body"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:gravity="center" android:text="@string/privacy_caption" android:textColor="@color/muted" android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
