<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/home_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/paper">
    <ScrollView android:id="@+id/home_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:fillViewport="true" android:background="@color/paper" android:clipToPadding="false" android:scrollbars="vertical" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp" android:paddingBottom="20dp">
            <include layout="@layout/home_overview" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/caution" style="@style/Buddy.Body" android:textSize="12sp" />
            <Button android:id="@+id/more_toggle" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Buddy.Button" android:layout_marginTop="18dp" android:background="@drawable/bg_more" android:text="@string/more_show" android:textColor="@color/ink_text" android:textAllCaps="false" />
            <LinearLayout android:id="@+id/more_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/hero_lead" android:textColor="@color/muted" android:textSize="14sp" android:lineSpacingExtra="5dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginBottom="12dp" android:text="@string/prepare" style="@style/Buddy.Section" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card">
                    <LinearLayout android:id="@+id/row_camera" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                        <TextView android:id="@+id/badge_camera" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:background="@drawable/bg_badge" android:text="1" android:textColor="@color/on_ink" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:minWidth="36dp" android:minHeight="36dp" android:padding="4dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/step_camera" android:textColor="@color/ink_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/step_camera_hint" android:textColor="@color/muted" android:textSize="12sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/state_camera" android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="end" android:text="@string/access_needed" android:textColor="@color/home_accent_text" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="62dp" android:background="@color/line" />
                    <LinearLayout android:id="@+id/row_pip" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp" android:clickable="true" android:focusable="true" android:foreground="?android:attr/selectableItemBackground">
                        <TextView android:id="@+id/badge_pip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:background="@drawable/bg_badge" android:text="2" android:textColor="@color/on_ink" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:minWidth="36dp" android:minHeight="36dp" android:padding="4dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/step_pip" android:textColor="@color/ink_text" android:textSize="15sp" android:fontFamily="sans-serif-medium" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/step_pip_hint" android:textColor="@color/muted" android:textSize="12sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/state_pip" android:layout_width="72dp" android:layout_height="wrap_content" android:gravity="end" android:text="@string/access_needed" android:textColor="@color/home_accent_text" android:textSize="12sp" android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:layout_marginBottom="12dp" android:text="@string/guide_title" style="@style/Buddy.Section" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/section_use" style="@style/Buddy.Section" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/use_body" style="@style/Buddy.Body" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="18dp" android:layout_marginBottom="18dp" android:background="@color/line" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/section_see" style="@style/Buddy.Section" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/see_body" style="@style/Buddy.Body" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center" android:text="@string/privacy_caption" android:textColor="@color/muted" android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:id="@+id/home_dock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="14dp" android:background="@drawable/bg_home_dock" android:elevation="6dp">
        <TextView android:id="@+id/home_action_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/home_action_stand" android:textSize="12sp" android:textColor="@color/muted" android:lineSpacingExtra="4dp" android:accessibilityTraversalAfter="@id/home_summary" android:accessibilityTraversalBefore="@id/start" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <Button android:id="@+id/stop" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Buddy.Button" android:background="@drawable/bg_stop" android:text="@string/preview_stop" android:textColor="@color/stop_text" android:minWidth="88dp" android:visibility="gone" android:enabled="false" android:accessibilityTraversalAfter="@id/home_action_hint" android:accessibilityTraversalBefore="@id/start" />
            <View android:id="@+id/home_action_gap" android:layout_width="8dp" android:layout_height="1dp" android:visibility="gone" android:importantForAccessibility="no" />
            <Button android:id="@+id/start" android:layout_width="0dp" android:layout_height="wrap_content" style="@style/Buddy.Button" android:background="@drawable/bg_primary" android:text="@string/start" android:textColor="@color/on_ink" android:layout_weight="1" android:accessibilityTraversalAfter="@id/home_action_hint" android:accessibilityTraversalBefore="@id/home_journey_label" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>