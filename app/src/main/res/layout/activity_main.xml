<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/paper">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_hero"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="26dp"
            android:paddingBottom="26dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hero_kicker"
                android:textColor="@color/mint_soft"
                android:textSize="13sp"
                android:letterSpacing="0.14"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hero_title"
                android:textColor="@color/on_ink"
                android:textSize="36sp"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/hero_lead"
                android:textColor="@color/on_ink_dim"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_label"
                android:textColor="@color/muted"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/status_initial"
                android:textColor="@color/ink_text"
                android:textSize="16sp"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="10dp"
            android:text="@string/prepare"
            android:textColor="@color/ink_text"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card">
        <LinearLayout
            android:id="@+id/row_camera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">
            <TextView
                android:id="@+id/badge_camera"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_badge"
                android:text="1"
                android:textColor="@color/on_ink"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_camera"
                    android:textColor="@color/ink_text"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_camera_hint"
                    android:textColor="@color/muted"
                    android:textSize="13sp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/state_camera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/access_needed"
                android:textColor="@color/mint"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="62dp"
            android:background="@color/line"/>
        <LinearLayout
            android:id="@+id/row_pip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">
            <TextView
                android:id="@+id/badge_pip"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_badge"
                android:text="2"
                android:textColor="@color/on_ink"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_pip"
                    android:textColor="@color/ink_text"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_pip_hint"
                    android:textColor="@color/muted"
                    android:textSize="13sp"/>
            </LinearLayout>
            <TextView
                android:id="@+id/state_pip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/access_needed"
                android:textColor="@color/mint"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/start"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_primary"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/start"
            android:textAllCaps="false"
            android:textColor="@color/on_ink"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"/>
        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_stop"
            android:backgroundTint="@null"
            android:stateListAnimator="@null"
            android:text="@string/preview_stop"
            android:textAllCaps="false"
            android:textColor="@color/stop_text"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/caution"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/section_use"
            android:textColor="@color/ink_text"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/use_body"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/section_see"
            android:textColor="@color/ink_text"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/see_body"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"/>
    </LinearLayout>
</ScrollView>
