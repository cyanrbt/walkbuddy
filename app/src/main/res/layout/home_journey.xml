<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="16dp" android:id="@+id/home_journey_card">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/journey_label" android:textColor="@color/home_accent_text" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:id="@+id/home_journey_label" android:accessibilityHeading="true" />
    <TextView android:id="@+id/journey_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/journey_hint_start" android:textColor="@color/home_accent_text" android:textSize="13sp" android:accessibilityLiveRegion="polite" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:id="@+id/home_steps" android:baselineAligned="false">
        <LinearLayout android:id="@+id/home_step_camera" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:minHeight="64dp" android:padding="4dp" android:focusable="true">
            <TextView android:id="@+id/home_dot_camera" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="28dp" android:minHeight="28dp" android:padding="4dp" android:gravity="center" android:background="@drawable/bg_badge" android:text="1" android:textColor="@color/on_ink" android:textSize="11sp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/home_label_camera" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="@string/journey_camera" android:textColor="@color/muted" android:textSize="12sp" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/home_step_preview" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:minHeight="64dp" android:padding="4dp" android:focusable="true">
            <TextView android:id="@+id/home_dot_preview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="28dp" android:minHeight="28dp" android:padding="4dp" android:gravity="center" android:background="@drawable/bg_badge" android:text="2" android:textColor="@color/on_ink" android:textSize="11sp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/home_label_preview" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="@string/journey_preview" android:textColor="@color/muted" android:textSize="12sp" android:importantForAccessibility="no" />
        </LinearLayout>
        <LinearLayout android:id="@+id/home_step_pip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center" android:minHeight="64dp" android:padding="4dp" android:focusable="true">
            <TextView android:id="@+id/home_dot_pip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="28dp" android:minHeight="28dp" android:padding="4dp" android:gravity="center" android:background="@drawable/bg_badge" android:text="3" android:textColor="@color/on_ink" android:textSize="11sp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/home_label_pip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:text="@string/journey_pip" android:textColor="@color/muted" android:textSize="12sp" android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:gravity="center_vertical" android:id="@+id/home_status_container">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/status_label" android:textSize="12sp" android:textColor="@color/muted" android:fontFamily="sans-serif-medium" android:id="@+id/home_status_label" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/status_initial" android:textColor="@color/ink_text" android:textSize="15sp" android:lineSpacingExtra="4dp" android:accessibilityLiveRegion="polite" android:layout_marginTop="6dp" />
    </LinearLayout>
    <Button android:id="@+id/journey_pip_settings" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Buddy.Button" android:layout_marginTop="8dp" android:background="@drawable/bg_more" android:text="@string/journey_pip_settings" android:textColor="@color/ink_text" android:visibility="gone" />
</LinearLayout>