<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink">

    <LinearLayout
        android:id="@+id/overlay_header"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_header"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/overlay_drag"
            android:textColor="@color/mint_soft"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/window_idle"
            android:textColor="@color/on_ink"
            android:textSize="13sp"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/overlay_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">
        <TextureView
            android:id="@+id/overlay_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:id="@+id/overlay_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="#000000"
            android:padding="20dp"
            android:text="@string/overlay_starting"
            android:textColor="@color/on_ink"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"/>
    </FrameLayout>

    <TextView
        android:id="@+id/overlay_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="2dp"
        android:text="@string/overlay_info_idle"
        android:textColor="@color/on_ink_dim"
        android:textSize="12sp"/>

    <CheckBox
        android:id="@+id/overlay_recognition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:text="@string/check_recognition"
        android:textColor="@color/on_ink"
        android:textSize="14sp"
        android:buttonTint="@color/mint_soft"/>
    <CheckBox
        android:id="@+id/overlay_sound"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:text="@string/check_sound"
        android:textColor="@color/on_ink"
        android:textSize="14sp"
        android:buttonTint="@color/mint_soft"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp">
        <Button
            android:id="@+id/overlay_stop"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stop"
            android:stateListAnimator="@null"
            android:text="@string/overlay_stop"
            android:textAllCaps="false"
            android:textColor="@color/paper"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:id="@+id/overlay_resize"
            android:layout_width="64dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/bg_resize"
            android:text="@string/overlay_resize"
            android:textColor="@color/on_ink"
            android:textSize="13sp"/>
    </LinearLayout>
</LinearLayout>
