<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ink">

    <LinearLayout
        android:id="@+id/overlay_header"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/on_ink"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:id="@+id/overlay_title"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_status_pill"
            android:text="@string/window_idle"
            android:textColor="@color/mint_soft"
            android:textSize="12sp"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/overlay_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:background="#000000">
        <TextureView
            android:id="@+id/overlay_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <TextView
            android:id="@+id/overlay_cover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="#000000"
            android:padding="22dp"
            android:text="@string/overlay_starting"
            android:textColor="@color/on_ink"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"/>
    </FrameLayout>

    <TextView
        android:id="@+id/overlay_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:text="@string/overlay_info_idle"
        android:textColor="@color/on_ink_dim"
        android:textSize="12sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp">
        <CheckBox
            android:id="@+id/overlay_recognition"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:button="@null"
            android:background="@drawable/bg_toggle"
            android:backgroundTint="@null"
            android:gravity="center"
            android:text="@string/check_recognition"
            android:textColor="@color/toggle_text"
            android:textSize="13sp"/>
        <CheckBox
            android:id="@+id/overlay_sound"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:button="@null"
            android:background="@drawable/bg_toggle"
            android:backgroundTint="@null"
            android:gravity="center"
            android:text="@string/check_sound"
            android:textColor="@color/toggle_text"
            android:textSize="13sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">
        <Button
            android:id="@+id/overlay_stop"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_stop"
            android:stateListAnimator="@null"
            android:text="@string/overlay_stop"
            android:textAllCaps="false"
            android:textColor="#E7A39C"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"/>
        <TextView
            android:id="@+id/overlay_resize"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_grip"
            android:contentDescription="@string/overlay_resize"/>
    </LinearLayout>
</LinearLayout>
