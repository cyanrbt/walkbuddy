<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WalkBuddy" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/mint</item>
        <item name="android:textColor">@color/ink_text</item>
    </style>
    <style name="Theme.WalkBuddy.HomeBase" parent="Theme.WalkBuddy">
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.WalkBuddy.Home" parent="Theme.WalkBuddy.HomeBase"/>
</resources>
