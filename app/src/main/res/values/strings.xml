<resources>
    <string name="app_name">Walk Buddy</string>
    <string name="hero_kicker">白天步行</string>
    <string name="hero_title">Walk Buddy</string>
    <string name="hero_lead">先确认后置镜头方向，再用系统画中画把实时画面留在旁边。无需悬浮窗权限。</string>
    <string name="status_label">现在</string>
    <string name="status_initial">已停止</string>
    <string name="prepare">开始之前</string>
    <string name="step_camera">摄像头</string>
    <string name="step_camera_hint">用来打开后置画面</string>
    <string name="access_ok">已允许</string>
    <string name="access_needed">点这里允许</string>
    <string name="start">打开摄像头预览</string>
    <string name="caution">先站着确认镜头方向。没有提醒，只说明这次没有出声，路还是要你自己看。</string>
    <string name="section_use">小窗怎么用</string>
    <string name="use_body">先在预览页确认取景，再点「以小窗观察」。点击小窗可返回完整界面或停止。识别和声音每次开启默认关闭；关闭小窗、锁屏或预览离开屏幕后会停止摄像头。</string>
    <string name="section_see">打开识别之后</string>
    <string name="see_body">只看这几类：人、自行车、汽车、摩托车、公交车、卡车、椅子、长凳。判断在手机上完成，不保存画面，应用也没有网络权限。人类目标包括成人和儿童，不区分年龄，也不能保证识别所有儿童。锥桶、围挡、上下台阶、坑洞和玻璃尚不支持；不测量距离。</string>
    <string name="toast_granted">已允许。准备好了再点开启。</string>
    <string name="toast_denied">还没有允许，窗口不会打开。</string>
    <string name="window_live">实时</string>
    <string name="window_idle">已停下</string>
    <string name="preview_starting">正在打开\n还没有实时画面</string>
    <string name="preview_info_idle">实时画面还不可用</string>
    <string name="check_recognition">识别</string>
    <string name="check_sound">声音</string>
    <string name="preview_stop">停止</string>
    <string name="info_recognition_off">识别关着，画面靠你看</string>
    <string name="info_recognition_on">正在准备本地识别</string>
    <string name="info_stopped">提醒已停止。返回完整界面后可主动重新开启。</string>
    <string name="step_pip">系统画中画（可选）</string>
    <string name="step_pip_hint">跨应用看画面，无需悬浮窗授权</string>
    <string name="pip_available">可用</string>
    <string name="pip_disabled">前往设置</string>
    <string name="pip_in_app_only">仅应用内</string>
    <string name="pip_unsupported">此设备不支持画中画，可以在应用内观察。离开预览页会停止摄像头。</string>
    <string name="pip_unavailable_title">暂时无法打开画中画</string>
    <string name="pip_unavailable_body">可以继续在应用内观察；离开预览页会停止摄像头。如果系统支持画中画，请在应用设置中允许后返回，并主动重新开启预览。</string>
    <string name="pip_settings">前往设置</string>
    <string name="keep_preview">继续应用内观察</string>
    <string name="settings_unavailable">无法打开设置，请在系统应用设置中查看。</string>
    <string name="enter_pip">以小窗观察</string>
    <string name="restart_preview">重新开启预览</string>
    <string name="preview_hint">绿色框表示检测到目标；黄色框表示进入画面中央关注区，连续确认后提醒，不代表实际距离。当前不支持锥桶、围挡、上下台阶和坑洞。声音仅在识别开启后可用。</string>
    <string name="posture_hint">镜头可能偏向地面或天空，请调整持机姿势，确认画面能看到前方</string>
</resources>
